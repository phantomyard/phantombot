{
  "name": "phantombot",
  "version": "0.1.0",
  "description": "Armors your harness, learns your world, zero context tax. Personality-first chat agent CLI on Bun.",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "phantombot": "src/index.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./engine": {
      "types": "./types/engine/index.d.ts",
      "default": "./src/engine/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "typecheck": "bun tsc --noEmit",
    "build:engine-types": "bun scripts/buildEngineTypes.ts",
    "gen:pi-extension": "bun scripts/genPiExtensionAssets.ts",
    "gen:vscode-vsix": "bun scripts/genVscodeVsix.ts",
    "build": "bun run build:x64",
    "build:x64": "bun build --compile --target=bun-linux-x64-baseline ./src/index.ts --outfile dist/phantombot",
    "build:arm64": "bun build --compile --target=bun-linux-arm64 ./src/index.ts --outfile dist/phantombot-arm64",
    "build:win": "bun build --compile --target=bun-windows-x64 ./src/index.ts --outfile dist/phantombot.exe",
    "tui:sandbox": "bun src/dev/tui-sandbox.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.3.0",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "citty": "^0.1.6",
    "cron-parser": "^5.5.0",
    "ink": "^6",
    "jsonc-parser": "^3.3.1",
    "nostr-tools": "2.23.3",
    "react": "^19",
    "react-devtools-core": "./scripts/stubs/react-devtools-core",
    "smol-toml": "^1.3.0",
    "string-width": "^8.2.2",
    "werift": "0.23.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "typescript": "^5.7.0"
  }
}
